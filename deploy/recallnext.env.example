EXASOL_DSN=exasol-nano/<sha256-certificate-fingerprint>:8563
EXASOL_USER=<database-user>
EXASOL_PASSWORD=<database-password>
EXASOL_SCHEMA=RECALLNEXT
EXASOL_ENCRYPTION=true
EXASOL_COMPRESSION=true
EXASOL_QUERY_TIMEOUT_SECONDS=30
RECALLNEXT_DATA_SOURCE=EXASOL_PERSONAL
RECALLNEXT_INCIDENT_ID=<incident-id>
RECALLNEXT_INCIDENT_VERSION=1
RECALLNEXT_REQUIRE_AUTH=true
RECALLNEXT_ADMIN_TOKEN=<random-secret-with-at-least-24-characters>
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=60
RECALLNEXT_MAX_DOCUMENT_BYTES=5242880
RECALLNEXT_STATIC_DIR=/app/frontend/dist
