# Copy this file to .env only for your own tooling. RecallNext reads process
# environment variables and never falls back to demo credentials.
# Starter-kit self-signed certificates use host/fingerprint:port. A deployment
# with a publicly trusted certificate may provide host:port instead.
EXASOL_DSN=<host>/<sha256-certificate-fingerprint>:<port>
EXASOL_USER=<database-user>
EXASOL_PASSWORD=<database-password>
EXASOL_SCHEMA=RECALLNEXT
EXASOL_ENCRYPTION=true
EXASOL_COMPRESSION=true
EXASOL_QUERY_TIMEOUT_SECONDS=30

# Use SYNTHETIC_FIXTURE for offline development. Use EXASOL_PERSONAL to make the
# visible API fail closed unless it can load the selected incident from Exasol.
RECALLNEXT_DATA_SOURCE=SYNTHETIC_FIXTURE
RECALLNEXT_INCIDENT_ID=<incident-id>
RECALLNEXT_INCIDENT_VERSION=<incident-version>

# The openFDA importer works without a key at its public rate limit. Set an
# official recall number at runtime; do not embed it in frontend code.
OPENFDA_RECALL_NUMBER=<openfda-food-enforcement-recall-number>
# OPENFDA_API_KEY=<optional-openfda-key>
